# Server
PORT=5000
FRONTEND_URL=http://localhost:5173

# Database (MongoDB connection string for local instance or MongoDB Atlas)
MONGODB_URI=mongodb://localhost:27017/iskcon_lms

# Authentication
JWT_SECRET=your_jwt_secret_key_here

# Optional: Supabase (server-side – use SERVICE ROLE key, never expose to frontend)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Optional: Zoom OAuth (Account Credentials / Server-to-Server)
ZOOM_ACCOUNT_ID=your_zoom_account_id
ZOOM_CLIENT_ID=your_zoom_client_id
ZOOM_CLIENT_SECRET=your_zoom_client_secret
